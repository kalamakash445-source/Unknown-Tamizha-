rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider != null);
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Collection Rules for 'stories'
    match /stories/{storyId} {
      allow read: if true; // Stories are public to view
      allow create: if isValidStories(incoming()) && isValidId(storyId);
      allow update: if isValidStories(incoming()) && isValidId(storyId);
      allow delete: if true; // Admin functions are showcase public without a login wall
    }

    function isValidStories(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 300
        && data.content is string && data.content.size() >= 10 && data.content.size() <= 200000
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 100
        && data.readsCount is int
        && (!("isTrending" in data) || data.isTrending is bool)
        && (!("subtitle" in data) || (data.subtitle is string && data.subtitle.size() <= 300))
        && (!("thumbnail" in data) || (data.thumbnail is string && data.thumbnail.size() <= 1000))
        && (!("creatorName" in data) || (data.creatorName is string && data.creatorName.size() <= 100))
        && (!("createdAt" in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    // Collection Rules for 'comments'
    match /comments/{commentId} {
      allow read: if true; // Public feedback reads
      allow create: if isValidComment(incoming()) && isValidId(commentId);
      allow update: if isValidComment(incoming()) && isValidId(commentId);
      allow delete: if true; // Allowed moderation on guest admin board
    }

    function isValidComment(data) {
      return data.storyId is string && isValidId(data.storyId)
        && data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() <= 200
        && data.commentText is string && data.commentText.size() > 0 && data.commentText.size() <= 10000;
    }

    // Collection Rules for 'bookmarks'
    match /bookmarks/{bookmarkId} {
      allow read, list: if true;
      allow create: if isValidBookmark(incoming()) && isValidId(bookmarkId);
      allow delete: if true;
    }

    function isValidBookmark(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.storyId is string && isValidId(data.storyId);
    }

    // Collection Rules for 'readingProgress'
    match /readingProgress/{progressId} {
      allow read: if true;
      allow create: if isValidProgress(incoming()) && isValidId(progressId);
      allow update: if isValidProgress(incoming()) && isValidId(progressId);
      allow delete: if true;
    }

    function isValidProgress(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.storyId is string && isValidId(data.storyId)
        && (data.scrollPercent is number || data.scrollPercent is int) && data.scrollPercent >= 0 && data.scrollPercent <= 100;
    }

    // Collection Rules for 'newsletter'
    match /newsletter/{subscriberId} {
      allow read: if true;
      allow create: if incoming().email is string && incoming().email.size() <= 200 && isValidId(subscriberId);
      allow delete: if true;
    }
  }
}
